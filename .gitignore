__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.pytest_cache/
.idea/

# ForgePilot runtime state (sessions, worktrees, repo mirrors, logs)
.forgepilot/

# Local environment overrides — may hold credentials. Never commit this.
.env.local
.env

# `pytest --cov` writes this beside whatever directory it ran in, so the gate left an
# untracked file in the repository root the first time it was run. Output, not source.
.coverage
.coverage.*
htmlcov/

# Generated knowledge-graph output (the /graphify skill). Build artefact: large,
# derived, and regenerated on demand — it has no business in the history.
graphify-out/

# Eval results and scratch repos. Output, not source: a run is reproduced by
# running it, and a committed result file is a claim nobody can check.
evals/results/
# Vestigial: scratch moved to `$FORGEPILOT_HOME/eval-scratch` because keeping it
# inside the repo put the eval's own answers one `..` from the agent's workspace,
# and created a nested git repository per worktree. Kept so an old checkout that
# still writes here cannot commit it.
evals/scratch/

# A writable temp root *inside* the workspace. Needed on a host whose spawned
# process tree cannot write to `%TEMP%` — this development box confines a command
# to the session workspace, so `tempfile.gettempdir()` falls back to the current
# directory and every `pytest` run drops its `tmp_path` tree (thousands of files)
# into the repository root. ForgePilot's own `mkdtemp(prefix="forgepilot-s-")`
# workspaces land in the same place. Point `TEMP`/`TMP` here to keep them out.
.tmp/
# And the same fallback when `$TEMP` is not set at all: ignored so that one
# forgotten variable cannot commit a few thousand generated files.
pytest-of-*/
